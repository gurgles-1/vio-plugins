{
  "plugins": [
    {
      "binaries": {
        "linux/amd64": {
          "url": "https://raw.githubusercontent.com/gurgles-1/vio-plugins/main/dist/vio-pmdb-lists/v0.3.0/vio-pmdb-lists-linux-amd64",
          "checksum": "c5e0733c05af91f020ea5870a71acb794dca731d096f92b7ee6e392115ba1462"
        },
        "linux/arm64": {
          "url": "https://raw.githubusercontent.com/gurgles-1/vio-plugins/main/dist/vio-pmdb-lists/v0.3.0/vio-pmdb-lists-linux-arm64",
          "checksum": "6f2321cfe869657b65f937f6514e37257e5ac04e7d5d865e054ebacfdc7e6bbf"
        }
      },
      "manifest": {
        "plugin_id": "com.gurgles-1.vio-pmdb-lists",
        "version": "0.3.0",
        "silo_api_version": "v1",
        "supported_platforms": [
          {
            "os": "linux",
            "arch": "amd64"
          },
          {
            "os": "linux",
            "arch": "arm64"
          }
        ],
        "capabilities": [
          {
            "type": "http_routes.v1",
            "id": "admin-routes",
            "display_name": "PMDB Lists Admin",
            "description": "Sync status and manual sync trigger for PublicMetaDB list imports."
          },
          {
            "type": "scheduled_task.v1",
            "id": "sync-pmdb-lists",
            "display_name": "Sync PMDB Lists",
            "description": "Fetches the configured PublicMetaDB lists and registers their titles as virtual media in the chosen libraries."
          }
        ],
        "global_config_schema": [
          {
            "key": "sync",
            "title": "PMDB list sync",
            "description": "Which PublicMetaDB lists to import and where to put them.",
            "json_schema": "{\"type\":\"object\",\"properties\":{\"pmdb_api_key\":{\"type\":\"string\"},\"pmdb_lists\":{\"type\":\"string\"},\"tmdb_api_key\":{\"type\":\"string\"},\"movie_library_id\":{\"type\":\"integer\",\"minimum\":1},\"series_library_id\":{\"type\":\"integer\",\"minimum\":1},\"sync_interval_minutes\":{\"type\":\"integer\",\"minimum\":15,\"maximum\":10080,\"default\":720},\"state_file\":{\"type\":\"string\",\"default\":\".vio-pmdb-lists-state.json\"},\"movie_library\":{\"type\":\"string\"},\"series_library\":{\"type\":\"string\"}},\"required\":[\"pmdb_api_key\",\"pmdb_lists\",\"tmdb_api_key\"],\"additionalProperties\":false}",
            "required": true,
            "admin_form": {
              "fields": [
                {
                  "key": "pmdb_api_key",
                  "label": "PublicMetaDB API Key",
                  "description": "Your PublicMetaDB API key (publicmetadb.com \u2192 account settings). Used to read your lists.",
                  "control": 3,
                  "placeholder": "pmdb_\u2026",
                  "secret": true
                },
                {
                  "key": "pmdb_lists",
                  "label": "PMDB Lists",
                  "description": "One entry per line: a PublicMetaDB list ID (your own lists), or a full public list URL like https://publicmetadb.com/lists/u/snoak/trending-kids-movies \u2014 public lists are read directly, no copy needed.",
                  "control": 2,
                  "placeholder": "https://publicmetadb.com/lists/u/snoak/trending-kids-movies\npvg2vr8nuvkh2g5",
                  "required": true,
                  "rows": 4
                },
                {
                  "key": "tmdb_api_key",
                  "label": "TMDB API Key",
                  "description": "TMDB API key (v3) or read access token (v4). Used for title metadata and TMDB \u2192 IMDb resolution.",
                  "control": 3,
                  "placeholder": "eyJhbG\u2026 or v3 api key",
                  "secret": true
                },
                {
                  "key": "movie_library",
                  "label": "Movies Library",
                  "description": "Movies library name (e.g. Movies). Leave blank to auto-detect the first Movies-type library.",
                  "control": 1,
                  "placeholder": "Movies"
                },
                {
                  "key": "series_library",
                  "label": "Series Library",
                  "description": "Series library name (e.g. TV). Leave blank to auto-detect the first Series-type library.",
                  "control": 1,
                  "placeholder": "TV"
                },
                {
                  "key": "sync_interval_minutes",
                  "label": "Sync Interval (minutes)",
                  "description": "Minimum time between automatic syncs. The scheduled task skips runs inside this window; the admin page can always force a sync.",
                  "control": 4,
                  "placeholder": "720"
                },
                {
                  "key": "state_file",
                  "label": "State File",
                  "description": "Where the plugin keeps its last-sync record. Defaults inside the plugin data directory.",
                  "control": 1,
                  "placeholder": ".vio-pmdb-lists-state.json"
                }
              ],
              "submit_label": "Save PMDB list sync"
            }
          }
        ],
        "http_routes": [
          {
            "id": "admin",
            "method": "GET",
            "path": "/admin/pmdb-lists",
            "access": "admin",
            "navigable": true,
            "navigation_label": "PMDB Lists",
            "navigation_kind": "admin"
          },
          {
            "id": "admin-api",
            "method": "*",
            "path": "/admin/pmdb-lists/*",
            "access": "admin"
          }
        ],
        "presentation": {
          "display_name": "PMDB Lists",
          "summary": "Import PublicMetaDB lists as virtual media libraries.",
          "description_markdown": "Reads your PublicMetaDB lists \u2014 or anyone's *public* lists, pasted as full URLs \u2014 on a schedule and registers every title as zero-storage virtual media in your Movies and Series virtual libraries. Items removed from a list are removed from your server on the next clean sync. Playback is handled by your configured virtual stream provider (e.g. a virtual library provider backed by AIOStreams).",
          "setup_markdown": "Enter your PublicMetaDB API key and one list per line \u2014 a list ID for your own lists, or a full public list URL like https://publicmetadb.com/lists/u/snoak/trending-kids-movies (public lists are read directly, no copy needed). Add a TMDB API key for metadata and IMDb resolution, then name your destination Movies and Series libraries (leave blank to auto-detect them). Press Sync Now on the PMDB Lists admin page to run the first import.",
          "homepage_url": "https://github.com/gurgles-1/vio-pmdb-lists",
          "source_url": "https://github.com/gurgles-1/vio-pmdb-lists",
          "support_url": "https://github.com/gurgles-1/vio-pmdb-lists/issues",
          "publisher_name": "gurgles-1",
          "publisher_url": "https://github.com/gurgles-1",
          "license_spdx": "MIT"
        }
      }
    },
    {
      "manifest": {
        "plugin_id": "com.gurgles-1.silo-pmdb-lists",
        "version": "0.1.0",
        "silo_api_version": "v1",
        "supported_platforms": [
          {
            "os": "linux",
            "arch": "amd64"
          },
          {
            "os": "linux",
            "arch": "arm64"
          }
        ],
        "capabilities": [
          {
            "type": "http_routes.v1",
            "id": "lists",
            "display_name": "PMDB Lists Admin",
            "description": "Sync status, manual sync trigger, and the browsable PMDB list pages."
          },
          {
            "type": "scheduled_task.v1",
            "id": "sync-pmdb-lists",
            "display_name": "Sync PMDB Lists",
            "description": "Fetches the configured PublicMetaDB lists, resolves titles through TMDB, and caches them for the browser pages."
          }
        ],
        "global_config_schema": [
          {
            "key": "sync",
            "title": "PMDB lists",
            "description": "Which PublicMetaDB lists to browse and how often to refresh them.",
            "json_schema": "{\"type\":\"object\",\"properties\":{\"pmdb_api_key\":{\"type\":\"string\"},\"pmdb_list_ids\":{\"type\":\"string\"},\"tmdb_api_key\":{\"type\":\"string\"},\"sync_interval_minutes\":{\"type\":\"integer\",\"minimum\":15,\"maximum\":10080,\"default\":720},\"state_file\":{\"type\":\"string\",\"default\":\".silo-pmdb-lists-cache.json\"}},\"required\":[\"pmdb_api_key\",\"pmdb_list_ids\",\"tmdb_api_key\"],\"additionalProperties\":false}",
            "required": true,
            "admin_form": {
              "fields": [
                {
                  "key": "pmdb_api_key",
                  "label": "PublicMetaDB API Key",
                  "description": "Your PublicMetaDB API key (publicmetadb.com \u2192 account settings). Used to read your lists.",
                  "control": 3,
                  "placeholder": "pmdb_\u2026",
                  "required": true,
                  "secret": true
                },
                {
                  "key": "pmdb_list_ids",
                  "label": "PMDB List IDs",
                  "description": "One PublicMetaDB list ID per line (the ID in the list URL, e.g. pvg2vr8nuvkh2g5).",
                  "control": 2,
                  "placeholder": "pvg2vr8nuvkh2g5\nhddzdnbivm49u1r",
                  "required": true,
                  "rows": 4
                },
                {
                  "key": "tmdb_api_key",
                  "label": "TMDB API Key",
                  "description": "TMDB API key (v3) or read access token (v4). Used for posters, metadata, and TMDB \u2192 IMDb resolution.",
                  "control": 3,
                  "placeholder": "eyJhbG\u2026 or v3 api key",
                  "required": true,
                  "secret": true
                },
                {
                  "key": "sync_interval_minutes",
                  "label": "Sync Interval (minutes)",
                  "description": "Minimum time between automatic syncs. The scheduled task skips runs inside this window; the admin page can always force a sync.",
                  "control": 4,
                  "placeholder": "720"
                },
                {
                  "key": "state_file",
                  "label": "Cache File",
                  "description": "Where the plugin keeps its synced list cache. Defaults inside the plugin data directory.",
                  "control": 1,
                  "placeholder": ".silo-pmdb-lists-cache.json"
                }
              ],
              "submit_label": "Save PMDB lists"
            }
          }
        ],
        "http_routes": [
          {
            "id": "lists",
            "method": "GET",
            "path": "/pmdb-lists",
            "access": "admin",
            "navigable": true,
            "navigation_label": "PMDB Lists",
            "navigation_kind": "admin"
          },
          {
            "id": "lists-api",
            "method": "*",
            "path": "/pmdb-lists/*",
            "access": "admin"
          }
        ],
        "presentation": {
          "display_name": "PMDB Lists (Silo)",
          "summary": "Browse PublicMetaDB lists inside Silo.",
          "description_markdown": "Browsable pages for your PublicMetaDB lists inside Silo. A scheduled task keeps the lists cached with TMDB posters and metadata, and each title is badged with whether it is already in your Silo libraries \u2014 handy for spotting what's on the list but missing from the library. (Silo's plugin API cannot add library items, so this is a discovery view; the companion Vio plugin turns the same lists into playable virtual libraries.)",
          "setup_markdown": "Enter your PublicMetaDB API key and one list ID per line, add a TMDB API key for posters and metadata, then press Sync Now on the PMDB Lists page to run the first import.",
          "homepage_url": "https://github.com/gurgles-1/silo-pmdb-lists",
          "source_url": "https://github.com/gurgles-1/silo-pmdb-lists",
          "support_url": "https://github.com/gurgles-1/silo-pmdb-lists/issues",
          "publisher_name": "gurgles-1",
          "publisher_url": "https://github.com/gurgles-1",
          "license_spdx": "MIT"
        }
      },
      "repo_url": "https://github.com/gurgles-1/vio-plugins",
      "binaries": {
        "linux/amd64": {
          "url": "https://raw.githubusercontent.com/gurgles-1/vio-plugins/main/dist/silo-pmdb-lists/v0.1.0/silo-pmdb-lists-linux-amd64",
          "checksum": "63dc490b04fd59004aa3cef8cb8df98f3f49198bee172c66564cef567d0c6ac2"
        },
        "linux/arm64": {
          "url": "https://raw.githubusercontent.com/gurgles-1/vio-plugins/main/dist/silo-pmdb-lists/v0.1.0/silo-pmdb-lists-linux-arm64",
          "checksum": "c506b399e50345757ff734ee523c4ec296322a763f943c53c70b33d7c01838c7"
        }

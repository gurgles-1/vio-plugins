    {
      "manifest": {
        "plugin_id": "com.gurgles-1.vio-aiostreams-watchsync",
        "version": "0.1.0",
        "silo_api_version": "v1",
        "supported_platforms": [
          {
            "os": "linux",
            "arch": "amd64"
          },
          {
            "os": "linux",
            "arch": "arm64"
          }
        ],
        "capabilities": [
          {
            "type": "watch_sync_provider.v1",
            "id": "aiostreams-watchsync",
            "display_name": "AIOStreams Watch Sync",
            "description": "Bidirectional watch-state sync between AIOStreams and Vio: imports AIOStreams playback/watchlist state into Vio and exports Vio's watch state back to AIOStreams.",
            "watch_sync_provider": {
              "auth_methods": [
                2
              ],
              "export_watched": true,
              "export_unwatched": true,
              "import_watched": true,
              "import_progress": true,
              "supported_media_types": [
                1,
                2
              ],
              "external_id_namespaces": [
                "imdb",
                "tmdb",
                "tvdb"
              ],
              "max_batch_size": 100,
              "import_watchlist": true,
              "export_watchlist": true,
              "scrobble_playback": true
            }
          },
          {
            "type": "http_routes.v1",
            "id": "watch-state-bridge",
            "display_name": "AIOStreams Handoff Bridge",
            "description": "AIOStreams handoff sink: receives playback/watchlist/rating events pushed by AIOStreams and serves Vio's watch state back in AIOStreams' pull format."
          },
          {
            "type": "http_routes.v1",
            "id": "admin-routes",
            "display_name": "Watch Sync Admin",
            "description": "Sync status and bridge diagnostics for the AIOStreams watch-state bridge."
          }
        ],
        "global_config_schema": [
          {
            "key": "watchsync",
            "title": "AIOStreams watch sync",
            "description": "Connection settings for the AIOStreams watch-state handoff bridge.",
            "json_schema": "{\"type\":\"object\",\"properties\":{\"sink_token\":{\"type\":\"string\"},\"aiostreams_base_url\":{\"type\":\"string\"},\"state_file\":{\"type\":\"string\",\"default\":\".vio-aiostreams-watchsync-state.json\"}},\"required\":[\"sink_token\"],\"additionalProperties\":false}",
            "required": true,
            "admin_form": {
              "fields": [
                {
                  "key": "sink_token",
                  "label": "Sink Token",
                  "description": "Shared secret appended as ?token= to the AIOStreams addon URL. AIOStreams forwards it on every push/pull request; the plugin rejects requests without it.",
                  "control": 3,
                  "placeholder": "a long random string",
                  "required": true,
                  "secret": true
                },
                {
                  "key": "aiostreams_base_url",
                  "label": "AIOStreams Base URL",
                  "description": "AIOStreams base URL, e.g. http://192.168.68.64:3006. Shown on the admin page for convenience; the bridge itself is driven by AIOStreams calling the plugin.",
                  "control": 1,
                  "placeholder": "http://192.168.68.64:3006"
                },
                {
                  "key": "state_file",
                  "label": "State File",
                  "description": "Where the plugin keeps its inbound/outbound event bridge state. Defaults inside the plugin data directory.",
                  "control": 1,
                  "placeholder": ".vio-aiostreams-watchsync-state.json"
                }
              ],
              "submit_label": "Save watch sync settings"
            }
          }
        ],
        "http_routes": [
          {
            "id": "watch-state-manifest",
            "method": "GET",
            "path": "/watch_state/manifest.json",
            "access": "public"
          },
          {
            "id": "watch-state-push",
            "method": "POST",
            "path": "/watch_state/push/*",
            "access": "public"
          },
          {
            "id": "watch-state-pull",
            "method": "GET",
            "path": "/watch_state/pull.json",
            "access": "public"
          },
          {
            "id": "admin",
            "method": "GET",
            "path": "/admin/aiostreams-watchsync",
            "access": "admin",
            "navigable": true,
            "navigation_label": "Watch Sync",
            "navigation_kind": "admin"
          },
          {
            "id": "admin-api",
            "method": "*",
            "path": "/admin/aiostreams-watchsync/*",
            "access": "admin"
          }
        ],
        "presentation": {
          "display_name": "AIOStreams Watch Sync",
          "summary": "Bidirectional watch-state sync between AIOStreams and Vio.",
          "description_markdown": "Bridges AIOStreams' watch-state handoff protocol and Vio's watch-sync provider API for bidirectional sync. AIOStreams pushes playback, watchlist, and rating events to the plugin's sink endpoint; Vio imports them through the watch-sync provider's ListRemoteState. Vio's own watch events flow back out through ApplyEvents and are served to AIOStreams in its pull format, so Continue Watching stays consistent in both directions.",
          "setup_markdown": "Set a sink token, then add the addon URL shown on the Watch Sync admin page to AIOStreams as a regular addon (it carries ?token=...). AIOStreams will push playback events to the plugin and pull Vio's watch state from it. Enable the provider in Vio's watch-sync settings to import AIOStreams state.",
          "homepage_url": "https://github.com/gurgles-1/vio-plugins",
          "source_url": "https://github.com/gurgles-1/vio-plugins",
          "support_url": "https://github.com/gurgles-1/vio-plugins/issues",
          "publisher_name": "gurgles-1",
          "publisher_url": "https://github.com/gurgles-1",
          "license_spdx": "MIT"
        }
      },
      "repo_url": "https://github.com/gurgles-1/vio-plugins",
      "binaries": {
        "linux/amd64": {
          "url": "https://raw.githubusercontent.com/gurgles-1/vio-plugins/main/dist/vio-aiostreams-watchsync/v0.1.0/vio-aiostreams-watchsync-linux-amd64",
          "checksum": "0ac45fac8b0824fba6cd4b879bc479947242deb49cfc06b709c8135a1d77fa20"
        },
        "linux/arm64": {
          "url": "https://raw.githubusercontent.com/gurgles-1/vio-plugins/main/dist/vio-aiostreams-watchsync/v0.1.0/vio-aiostreams-watchsync-linux-arm64",
          "checksum": "61d94b6a6174f28b6d039d7a811e4e081f51c43f05191db97d0c7fd0226ec4bc"
        }
      }
    },

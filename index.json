    {
      "manifest": {
        "plugin_id": "com.gurgles-1.kometa-artwork",
        "version": "0.1.0",
        "silo_api_version": "v1",
        "supported_platforms": [
          {
            "os": "linux",
            "arch": "amd64"
          },
          {
            "os": "linux",
            "arch": "arm64"
          }
        ],
        "capabilities": [
          {
            "type": "http_routes.v1",
            "id": "admin-routes",
            "display_name": "Kometa Artwork Admin",
            "description": "Sync status and manual artwork-apply trigger for Kometa collection artwork."
          },
          {
            "type": "scheduled_task.v1",
            "id": "sync-kometa-artwork",
            "display_name": "Apply Kometa Artwork",
            "description": "Matches collections by title to Kometa Default-Images and applies poster/backdrop artwork."
          }
        ],
        "global_config_schema": [
          {
            "key": "sync",
            "title": "Kometa artwork sync",
            "description": "Which server to update and where the artwork comes from.",
            "json_schema": "{\"type\":\"object\",\"properties\":{\"host_api_key\":{\"type\":\"string\"},\"host_base_url\":{\"type\":\"string\"},\"kometa_base_url\":{\"type\":\"string\"},\"dry_run\":{\"type\":\"boolean\"},\"overwrite_existing\":{\"type\":\"boolean\"},\"sync_interval_minutes\":{\"type\":\"integer\",\"minimum\":15,\"maximum\":43200,\"default\":10080},\"state_file\":{\"type\":\"string\",\"default\":\".kometa-artwork-state.json\"}},\"required\":[\"host_api_key\"],\"additionalProperties\":false}",
            "required": true,
            "admin_form": {
              "fields": [
                {
                  "key": "host_api_key",
                  "label": "Host API Key",
                  "description": "Vio/Silo admin API key (unscoped v2 key). Used to list collections and upload artwork via the host admin API.",
                  "control": 3,
                  "placeholder": "sa_\u2026",
                  "secret": true
                },
                {
                  "key": "host_base_url",
                  "label": "Host Base URL",
                  "description": "Base URL of the Vio/Silo server as seen from the plugin process. Defaults to localhost; the plugin runs on the same box as the server.",
                  "control": 1,
                  "placeholder": "http://localhost:8190"
                },
                {
                  "key": "kometa_base_url",
                  "label": "Kometa Base URL",
                  "description": "Base URL for Kometa Default-Images. Use the jsDelivr CDN (default) or raw.githubusercontent.com as a fallback.",
                  "control": 1,
                  "placeholder": "https://cdn.jsdelivr.net/gh/Kometa-Team/Default-Images@master"
                },
                {
                  "key": "dry_run",
                  "label": "Dry Run",
                  "description": "Preview matches without uploading any artwork.",
                  "control": 5
                },
                {
                  "key": "overwrite_existing",
                  "label": "Overwrite Existing Artwork",
                  "description": "When off, collections that already have a poster are skipped. When on, every matched collection gets fresh artwork.",
                  "control": 5
                },
                {
                  "key": "sync_interval_minutes",
                  "label": "Sync Interval (minutes)",
                  "description": "Minimum time between automatic syncs. The scheduled task skips runs inside this window; the admin page can always force a run.",
                  "control": 4,
                  "placeholder": "10080"
                },
                {
                  "key": "state_file",
                  "label": "State File",
                  "description": "Where the plugin keeps its last-run record. Defaults inside the plugin data directory.",
                  "control": 1,
                  "placeholder": ".kometa-artwork-state.json"
                }
              ],
              "submit_label": "Save Kometa artwork settings"
            }
          }
        ],
        "http_routes": [
          {
            "id": "admin",
            "method": "GET",
            "path": "/admin/kometa-artwork",
            "access": "admin",
            "navigable": true,
            "navigation_label": "Kometa Artwork",
            "navigation_kind": "admin"
          },
          {
            "id": "admin-api",
            "method": "*",
            "path": "/admin/kometa-artwork/*",
            "access": "admin"
          }
        ],
        "presentation": {
          "display_name": "Kometa Artwork",
          "summary": "Apply Kometa Default-Images artwork to collections.",
          "description_markdown": "Matches your Vio/Silo collections by title to the Kometa Default-Images library (~16k community collection posters) and applies matching poster/backdrop artwork. Covers franchises (Star Wars, Marvel, DC\u2026), streaming services, genres, holidays, studios, years, and awards. Run manually from the admin page or on a schedule; dry-run mode previews matches without changing anything.",
          "setup_markdown": "Enter your Vio/Silo admin API key (an unscoped v2 key). The Host Base URL defaults to http://localhost:8190 \u2014 the plugin runs on the same box as the server, so localhost is usually right. Pick whether to overwrite collections that already have artwork, then press Apply Now on the Kometa Artwork admin page (dry-run first to preview).",
          "homepage_url": "https://github.com/gurgles-1/vio-plugins",
          "source_url": "https://github.com/gurgles-1/vio-plugins",
          "support_url": "https://github.com/gurgles-1/vio-plugins/issues",
          "publisher_name": "gurgles-1",
          "publisher_url": "https://github.com/gurgles-1",
          "license_spdx": "MIT"
        }
      },
      "repo_url": "https://github.com/gurgles-1/vio-plugins",
      "binaries": {
        "linux/amd64": {
          "url": "https://raw.githubusercontent.com/gurgles-1/vio-plugins/main/dist/kometa-artwork/v0.1.0/kometa-artwork-linux-amd64",
          "checksum": "871c3820cb6d79576712f47d7314b76f8eb3b45367534a7d72a6790c763e3b01"
        },
        "linux/arm64": {
          "url": "https://raw.githubusercontent.com/gurgles-1/vio-plugins/main/dist/kometa-artwork/v0.1.0/kometa-artwork-linux-arm64",
          "checksum": "3c8d1c4ec7f6cef331e3abf36f1ed9e96386ba41c1e7653b7576889715fdd02e"
        }
      }
    },
    {
      "manifest": {
        "plugin_id": "com.gurgles-1.vio-cover-studio",
        "version": "0.1.3",
        "silo_api_version": "v1",
        "supported_platforms": [
          {
            "os": "linux",
            "arch": "amd64"
          },
          {
            "os": "linux",
            "arch": "arm64"
          }
        ],
        "capabilities": [
          {
            "type": "http_routes.v1",
            "id": "admin-routes",
            "display_name": "Cover Studio Admin",
            "description": "Cover Studio admin page: collection list, per-collection options, live previews, and manual rebuilds."
          },
          {
            "type": "scheduled_task.v1",
            "id": "rebuild-covers",
            "display_name": "Rebuild Covers",
            "description": "Rebuilds collection covers (mosaic poster + backdrop) for the enabled collections."
          }
        ],
        "global_config_schema": [
          {
            "key": "covers",
            "title": "Cover Studio",
            "description": "Which collections get generated covers and how they look.",
            "json_schema": "{\"type\": \"object\", \"properties\": {\"vio_url\": {\"type\": \"string\", \"default\": \"http://127.0.0.1:8080\"}, \"vio_api_key\": {\"type\": \"string\"}, \"tmdb_api_key\": {\"type\": \"string\"}, \"collections\": {\"type\": \"string\"}, \"overlay_mode\": {\"type\": \"string\", \"enum\": [\"logo\", \"text\", \"none\", \"\"], \"default\": \"logo\"}, \"layout\": {\"type\": \"string\", \"enum\": [\"grid\", \"spotlight\", \"columns\", \"\"], \"default\": \"grid\"}, \"refresh_hours\": {\"type\": \"integer\", \"minimum\": 1, \"maximum\": 168, \"default\": 24}}, \"required\": [\"vio_api_key\", \"tmdb_api_key\"], \"additionalProperties\": false}",
            "required": true,
            "admin_form": {
              "fields": [
                {
                  "key": "vio_url",
                  "label": "Server URL",
                  "description": "Vio/Silo server URL (the address the web app opens on, not the Jellyfin-compatible port).",
                  "control": 1,
                  "placeholder": "http://127.0.0.1:8080"
                },
                {
                  "key": "vio_api_key",
                  "label": "Server API Key",
                  "description": "Vio/Silo administrator API key (Admin > API keys). Used to read collections and upload covers.",
                  "control": 3,
                  "placeholder": "sa_\u2026",
                  "secret": true
                },
                {
                  "key": "tmdb_api_key",
                  "label": "TMDB API Key",
                  "description": "TMDB API key (v3) or read access token (v4). Used to pull collection logos automatically.",
                  "control": 3,
                  "placeholder": "eyJhbG\u2026 or v3 api key",
                  "secret": true
